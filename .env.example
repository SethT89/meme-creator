# Copy to .env.local and fill in from your Supabase project settings.
# .env.local is gitignored.

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Client-safe copies for the app itself (Vite only exposes VITE_-prefixed vars to the browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. NEVER expose to the browser / commit. (Project Settings -> API)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase CLI / MCP (Account -> Access Tokens). Used for migrations + the MCP server.
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# The single hardcoded v1 user id (matches the migration default).
APP_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
